{
  "name": "@campusconnect/web",
  "version": "0.0.0",
  "private": true,
  "description": "React + Vite PWA with the (student), (workbench), (exec), (admin) and (ops) route groups.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
