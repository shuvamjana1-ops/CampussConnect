    "@campusconnect/i18n": "workspace:*",
    "@campusconnect/ui": "workspace:*",
    "@tanstack/react-query": "5.85.5",
    "i18next": "25.5.2",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "react-router": "7.8.2"
  },
  "devDependencies": {
    "@campusconnect/tooling": "workspace:*",
    "@types/node": "catalog:",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vite": "7.1.3",
    "vitest": "catalog:"
  }
}
