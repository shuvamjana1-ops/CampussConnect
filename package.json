{
  "name": "campusconnect",
  "version": "0.0.0",
  "private": true,
  "description": "CampusConnect multi-tenant platform for student and institution communication and campus services.",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^22.13.0"
  },
  "scripts": {
    "build": "turbo run build",
    "build:web": "pnpm --filter @campusconnect/web build",
    "depcruise": "depcruise apps packages infra tools --config .dependency-cruiser.mjs",
    "dev": "turbo run dev",
    "dev:web": "pnpm --filter @campusconnect/web dev",
    "lint": "turbo run lint --filter=@campusconnect/web --filter=@campusconnect/ui --filter=@campusconnect/i18n",
    "lint:all": "turbo run lint",
    "preview": "turbo run preview",
    "seed": "node scripts/seed.js",
    "test": "turbo run test",
    "test:integration": "turbo run test:integration",
    "test:isolation": "node scripts/test-isolation.js",
    "typecheck": "turbo run typecheck --filter=@campusconnect/web --filter=@campusconnect/ui --filter=@campusconnect/i18n",
    "typecheck:all": "turbo run typecheck"
  },
  "devDependencies": {
    "@campusconnect/tooling": "workspace:*",
    "dependency-cruiser": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.118.0",
    "dotenv": "^18.0.9"
  }
}
