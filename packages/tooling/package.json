{
  "name": "@campusconnect/tooling",
  "version": "0.0.0",
  "private": true,
  "description": "Shared tsconfig, ESLint config, Vitest presets and dependency-cruiser rules.",
  "type": "module",
  "exports": {
    "./dependency-cruiser": "./dependency-cruiser/config.mjs",
    "./eslint": {
      "types": "./eslint/index.d.ts",
      "default": "./eslint/index.js"
    },
    "./tsconfig/base.json": "./tsconfig/base.json",
    "./vitest": {
      "types": "./vitest/preset.d.ts",
      "default": "./vitest/preset.js"
    },
    "./vitest/setup": "./vitest/setup.js"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@eslint/js": "catalog:",
    "fast-check": "catalog:",
    "globals": "catalog:",
    "typescript-eslint": "catalog:"
  },
  "peerDependencies": {
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "dependency-cruiser": "catalog:",
    "eslint": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
